# Database Configuration (local API)
SQL_CONN=Host=localhost;Database=MushroomMapApp;Username=postgres;Password=your_password
# For docker-compose networking use:
#SQL_CONN=Host=mushroommapapp.db;Database=MushroomMapApp;Username=root;Password=your_password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=MushroomMapApp

# Redis Configuration (local API)
REDIS_CONN=localhost:6379,abortConnect=false
# For docker-compose networking use:
#REDIS_CONN=redis:6379,abortConnect=false

# API and CORS
API_URL=https://www.mushroom-app.com
CORS_URLS=http://localhost:5173,http://localhost:4174,http://localhost:4175,https://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# JWT Configuration
JWT_KEY=your_secure_random_jwt_secret_key_at_least_32_chars
JWT_TIME_EXPIRE_MINUTES=60
JWT_ISSUER=https://www.mushroom-app.com

# File Storage
FILES_STORAGE=Storage/Files

# Email Configuration (e.g., for Ethereal or SMTP)
EMAIL_HOST=smtp.ethereal.email
EMAIL=noreply@example.com
EMAIL_FROMNAME=MushroomMapApp
EMAIL_USERNAME=your_username
EMAIL_PASSWORD=your_password
EMAIL_PORT=587

# Hangfire Dashboard Credentials
HANGFIRE_USERNAME=Admin
HANGFIRE_PASSWORD=admin_password

# Weather (Open-Meteo)
OPEN_METEO_URL="https://api.open-meteo.com/"

# Frontend (src/MushroomMapApp.Web/.env)
# VITE_API_URL=http://localhost:5000/api
